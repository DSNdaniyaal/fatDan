// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  password  String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Stock {
  id      Int       @id @default(autoincrement())
  name    String    @unique   
  symbol  String    @unique
}

model Order {
  id        Int                         @id @default(autoincrement())
  qty       String
  content   String?
  user      User                        @relation(fields: [userId], references: [id])
  userId    Int
  createdAt TimestamptzString           @default(now())
  updatedAt temporal.updatedAtString()
}


